# Copy to .env locally and load it with your preferred environment manager.
# Never commit real secrets, SSH keys, or production credentials.

# Raspberry Pi connection
UAV_PI_HOST=192.168.1.50
UAV_PI_USER=pi
UAV_PI_SSH_KEY=~/.ssh/id_rsa
UAV_ROSBRIDGE_URL=ws://192.168.1.50:9090

# Optional elevation API key. Leave blank when not used.
ORS_API_KEY=

# Local storage and HTTP port
UAV_MISSION_STORAGE=./missions
UAV_GCS_PORT=5000

# Set a long random value before any shared-network use.
# This value is not yet enforced by every control route in the current app;
# see SECURITY.md and do not expose the server to untrusted networks.
UAV_SECRET_KEY=replace-with-a-long-random-secret
