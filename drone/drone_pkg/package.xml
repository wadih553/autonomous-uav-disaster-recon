<?xml version="1.0"?>
<package format="3">
  <name>drone_pkg</name>
  <version>1.0.0</version>
  <description>Camera streaming, environmental sensors (SHT3X, MQ-135), and mission file reception for the autonomous disaster-reconnaissance UAV.</description>
  <maintainer email="wadihdahrouge1@gmail.com">Wadih Dahrouge</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
